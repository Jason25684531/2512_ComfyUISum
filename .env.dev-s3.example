# ============================================
# 本地 S3 模擬測試用環境變數範本
# ============================================
# 複製此檔案為 .env.dev-s3 並填入實際值：
#   cp .env.dev-s3.example .env.dev-s3
#
# 搭配 docker-compose.dev-s3.yml 使用：
#   docker compose -f docker-compose.dev-s3.yml --env-file .env.dev-s3 up -d
# ============================================

PLATFORM=windows
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD>

MYSQL_ROOT_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD>
DB_HOST=localhost
DB_PORT=3307
DB_USER=studio_user
DB_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD>
DB_NAME=studio_db

COMFYUI_HOST=localhost
COMFY_HOST=localhost
COMFYUI_PORT=8188

# S3 模擬（指向本地 MinIO）
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio-outputs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=
