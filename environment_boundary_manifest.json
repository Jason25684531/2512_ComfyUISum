    "docker-compose.dev.yml",
    "docker-compose.dev-s3.yml",
    "ComfyUIworkflow_Windows/",
    ".env.unified.example"
  ],
  "path_allowlist": [
    "openspec/config.yaml",
    "shared/utils.py",
    "README.md",
    ".env.local.example",
    ".env.twcc.example",
    ".env.unified.example",
    "openspec/specs/environment-spec.md",
    "docker-compose.yml",
    "docker-compose.unified.yml",
    "docker-compose.base.yml",
    "docs/",
    "nginx/",
    "worker/worker.service.template",
    "scripts/start_unified_windows.bat",
    "scripts/start_unified_linux.sh",
    "scripts/twcc_gpu_setup.sh"
  ],
  "scan_exclude_prefixes": [
    "openspec/changes/environment-preservation-spec/",
    "openspec/specs/environment-spec.md"
  ],
  "forbidden_literals": [
    "202.5.255.9"
