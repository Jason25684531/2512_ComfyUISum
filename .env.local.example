# ============================================
# Studio Core 本地 canonical 環境範例
# 使用方式：copy .env.local.example .env.local
# 搭配：docker compose -f docker-compose.yml --env-file .env.local up -d
#
# 拓撲：ComfyUI 在 Windows 原生執行（:8188），
#        redis / mysql / backend / worker 在 Docker Desktop（WSL2）執行。
# ============================================

STUDIO_ENV=local
DEPLOYMENT_TOPOLOGY=local-dev
ENV_CONTRACT_FILE=./.env.local

FLASK_ENV=development
FLASK_DEBUG=True
BACKEND_PORT=5000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_PASSWORD=<REPLACE_WITH_LOCAL_REDIS_PASSWORD>

DB_HOST=127.0.0.1
DB_PORT=3307
DB_INTERNAL_PORT=3306
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=<REPLACE_WITH_LOCAL_MYSQL_ROOT_PASSWORD>
DB_NAME=studio_db
DB_USER=studio_user
DB_PASSWORD=<REPLACE_WITH_LOCAL_DB_PASSWORD>

SECRET_KEY=<REPLACE_WITH_LOCAL_SECRET_KEY>

# ComfyUI 端點（Docker 容器連 Windows 主機的正確 hostname）
# host.docker.internal 由 Docker Desktop（Windows/macOS）自動解析為宿主機 IP
# 若使用 Linux 裸 Docker，請改為 Windows 主機的實際 IP 或 gateway IP
COMFYUI_SERVER_URL=http://host.docker.internal:8188
COMFYUI_HOST=host.docker.internal
COMFY_HOST=host.docker.internal
COMFYUI_PORT=8188

MODEL_PATH=/mnt/d/02_software/ComfyUI_windows_portable/ComfyUI/models
WORKFLOW_DIR=./ComfyUIworkflow
STORAGE_DIR=./storage
STORAGE_OUTPUT_DIR=./storage/outputs
LOG_DIR=./logs

WORKER_TIMEOUT=3600
COMFY_HTTP_TIMEOUT=300
COMFY_POLLING_INTERVAL=0.5
