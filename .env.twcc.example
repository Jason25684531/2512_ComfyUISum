# ============================================
# Studio Core TWCC 環境契約範例
# 使用方式：cp .env.twcc.example .env.twcc
# Base VM canonical：docker compose -f docker-compose.base.yml --env-file .env.twcc up -d
# GPU VM canonical：sudo bash scripts/twcc_gpu_setup.sh
# ============================================

STUDIO_ENV=twcc
DEPLOYMENT_TOPOLOGY=twcc-base-vm
ENV_CONTRACT_FILE=./.env.twcc

PLATFORM=linux
RESTART_POLICY=unless-stopped
BACKEND_PORT=5000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_PASSWORD=<REPLACE_WITH_TWCC_REDIS_PASSWORD>

SECRET_KEY=<REPLACE_WITH_RANDOM_SECRET>
SESSION_COOKIE_SECURE=true
PROXY_FIX=true

TWCC_GATEWAY_HOST=<TWCC_GATEWAY_HOST>
TWCC_BASE_HOST=<TWCC_BASE_HOST>
TWCC_GPU_NODE_HOST=<TWCC_GPU_NODE_HOST>
GPU_VM_REDIS_HOST=<TWCC_BASE_PRIVATE_HOST>
LB_DOMAIN=<TWCC_LB_DOMAIN>

COMFYUI_SERVER_URL=http://<TWCC_GPU_NODE_HOST>:8188
COMFYUI_HOST=<TWCC_GPU_NODE_HOST>
COMFY_HOST=<TWCC_GPU_NODE_HOST>
COMFYUI_PORT=8188

WORKFLOW_DIR=./ComfyUIworkflow
STORAGE_OUTPUT_DIR=./storage/outputs
LOG_DIR=./logs

TWCC_API_KEY=<TWCC_API_KEY>
TWCC_PROJECT_ID=<TWCC_PROJECT_ID>
TWCC_GPU_VM_ID=<TWCC_GPU_VM_ID>

COMFY_HTTP_TIMEOUT=300
WORKER_TIMEOUT=3600
COMFY_POLLING_INTERVAL=0.5
TWCCLI_PATH=/home/ubuntu/.local/bin/twccli
